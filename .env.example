# =====================================================================
# VARIABLES DE ENTORNO — copia este archivo a ".env" y rellena valores
# NUNCA subas ".env" a git (está en .gitignore)
#
# [CONCEPTO: 12-Factor App — Config]
# Las apps de producción separan configuración del código.
# Las credenciales viven en el entorno, no en el repositorio.
# Aprende más: https://12factor.net/config
# =====================================================================

# --- Telegram ---
# Obtén tu token hablando con @BotFather en Telegram
# Comandos: /newbot → elige nombre → elige username → recibes el token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- DeepSeek API ---
# Regístrate en https://platform.deepseek.com
# Dashboard → API Keys → Create new key
# Modelo usado: deepseek-chat (DeepSeek-V3) — muy barato y capaz
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- Seguridad Webhook (n8n → bot) ---
# Cadena secreta que n8n envía en el header "X-Webhook-Secret"
# para que solo n8n pueda disparar recordatorios.
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=cambia_esto_por_algo_secreto

# --- Servidor ---
PORT=8000
DATABASE_PATH=data/heracles.db

# --- App Web ---
# URL pública donde está accesible el servidor (para el comando /webapp del bot).
# Con Cloudflare Tunnel: https://tu-subdominio.domain.com
# Sin dominio público: http://localhost:8000
WEB_URL=https://tu-dominio.com

# --- Zona horaria ---
# Afecta qué día es "hoy" para el plan y el historial diario.
# Ejemplos: America/Santiago, America/Bogota, America/Mexico_City, Europe/Madrid
TIMEZONE=America/Santiago

# --- Control de acceso ---
# Tu Telegram ID (lo obtienes hablando con @userinfobot en Telegram).
ADMIN_TELEGRAM_ID=tu_telegram_id_aqui
